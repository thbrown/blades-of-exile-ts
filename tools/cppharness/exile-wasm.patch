+			// implements the pref API against browser storage instead — so
+			// nothing consumes the <load_prefs> the recording opens with, and
+			// the game's own srand then finds it still at the head of the
+			// stream and refuses. Apply it here through the same `set_pref`
+			// API, mirroring `load_prefs` (prefs.cpp:208). These are not all
+			// cosmetic: `LessWanderingMonsters` is read by the wandering roll.
+			if(has_next_action("load_prefs")) {
+				Element& prefs_action = pop_next_action("load_prefs");
+				std::string text;
+				prefs_action.GetTextOrDefault(&text, "");
+				std::istringstream in(text);
+				std::string line;
+				while(std::getline(in, line)) {
+					if(line.empty() || line[0] == '#') continue;
+					size_t eq = line.find_first_of('=');
+					if(eq == std::string::npos) continue;
+					size_t key_end = line.find_last_not_of(' ', eq - 1);
+					size_t val_beg = line.find_first_not_of(' ', eq + 1);
+					if(key_end == std::string::npos || val_beg == std::string::npos) continue;
+					std::string key = line.substr(0, key_end + 1);
+					std::string val = line.substr(val_beg);
+					if(val == "true") set_pref(key, true);
+					else if(val == "false") set_pref(key, false);
+					else if(val[0] == '"' || val[0] == '\'') set_pref(key, val.substr(1, val.size() - 2));
+					else if(val[0] == '[') {
+						// `ReceivedHelp` is the only int array, and skipping it
+						// is not cosmetic: `give_help` returns early for a topic
+						// already in it, so a recording that has seen a hint
