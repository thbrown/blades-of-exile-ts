+						std::istringstream nums(val.substr(1, val.find_last_of(']') - 1));
+						int n;
+						while(nums >> n) append_iarray_pref(key, n);
+					}
+					else if(val.find_first_of('.') != std::string::npos) set_pref(key, std::stod(val));
+					else set_pref(key, std::stoi(val));
+				}
+			}
+			// A replay that opened with a saved game loads it before anything else.
+			if(has_next_action("load_party")) replay_next_action();
+		}
