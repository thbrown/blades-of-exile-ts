+static bool trace_on() {
+	static int on = -1;
+	if(on < 0) on = getenv("BOE_TRACE") != nullptr;
+	return on;
+}
+
+void trace_pc_pos();
+
+void trace_ran(short times, short lo, short hi, short result) {
+	static long n = 0;
+	static bool on = getenv("BOE_TRACE_RAN") != nullptr;
+	static long limit = on ? atol(getenv("BOE_TRACE_RAN")) : 0;
+	// BOE_TRACE_RAN_STACK=k prints the stack for draw k — the pair to `RANSTACK`
+	// on the exile-js side. "The two streams part at draw k" is only half an
+	// answer; the other half is which rule made the call.
+	static long stack_at = getenv("BOE_TRACE_RAN_STACK")
+		? atol(getenv("BOE_TRACE_RAN_STACK")) : 0;
+	if(!on || ++n > limit) return;
+	std::cout << "    [ran] " << n << " get_ran(" << times << "," << lo << "," << hi
+		<< ") = " << result << std::endl;
+	if(n == stack_at) {
+		std::cout.flush();
+		void* frames[32];
+		int got = backtrace(frames, 32);
+		backtrace_symbols_fd(frames, got, 1);
+	}
+	trace_pc_pos();
+}
+
+// BOE_TRACE_PCPOS=1 — one line whenever a PC's combat position changes, checked
+// on every traced draw. A PC that moved with nobody watching is the hardest
+// divergence to place: the action trace only prints the *active* PC, `pcs:` is
+// a snapshot taken at action dispatch, and everything in between is invisible.
+// Anchoring the check to the draw stream means the line lands between two
+// numbered draws, which names the rule to within a few statements.
+void trace_pc_pos() {
+	static bool on = getenv("BOE_TRACE_PCPOS") != nullptr;
+	if(!on) return;
+	static location last[6];
+	static bool primed = false;
+	for(short p = 0; p < 6; p++) {
+		if(primed && (last[p].x != univ.party[p].combat_pos.x
+			|| last[p].y != univ.party[p].combat_pos.y))
+			std::cout << "      [pcpos] " << p << " (" << last[p].x << "," << last[p].y
+				<< ") -> (" << univ.party[p].combat_pos.x << ","
+				<< univ.party[p].combat_pos.y << ")" << std::endl;
+		last[p] = univ.party[p].combat_pos;
+	}
+	primed = true;
+}
+
+void trace_action(const std::string& type, const std::string& text) {
+	static int n = 0;
+	n++;
+	if(!trace_on()) return;
+	bool fight = overall_mode == MODE_COMBAT;
+	location l = fight ? univ.party[univ.cur_pc].combat_pos
+		: (univ.party.town_num < 200 ? univ.party.town_loc : univ.party.out_loc);
+	std::cout << "  " << std::setw(5) << n << " " << std::left << std::setw(20) << type
+		<< std::right << " " << std::setw(10) << text.substr(0, 10)
+		<< " -> (" << l.x << "," << l.y << ")";
+	if(fight)
+		std::cout << " pc" << univ.cur_pc << ":" << univ.party[univ.cur_pc].name
+			<< "(" << univ.party[univ.cur_pc].ap << "ap)";
+	// `cur=` is `univ.cur_pc`. Outside combat the line above prints no PC at
+	// all, and cur_pc still decides who the get-items screen hands its pile to.
+	// `dir=` is `univ.party.direction`, the party's facing. Nothing prints it
+	// and nothing else reads it — except `start_town_combat`, which deals the
+	// whole party onto the board from it, so a facing that drifted three
+	// hundred actions ago surfaces as PCs standing on the wrong squares.
+	std::cout << " mode=" << int(overall_mode) << " cur=" << univ.cur_pc
+		<< " dir=" << int(univ.party.direction) << " age=" << univ.party.age;
+	// BOE_TRACE_CENTER: the view centre. `handle_terrain_screen_actions` builds
+	// every recorded `move` destination from *this*, not from the party or the
+	// acting PC, so a move that looks two squares long is usually a centre the
+	// other side put somewhere else.
+	if(getenv("BOE_TRACE_CENTER"))
+		std::cout << " center=(" << center.x << "," << center.y << ")";
+	// BOE_TRACE_LIGHT: the party's light and whether its own square counts as
+	// lit. `pt_in_light` gates `can_see_light`, which gates every notice roll
+	// in a dark town — so a divergence here reads as a creature that saw the
+	// party on one side and not on the other, with every position agreeing.
+	if(getenv("BOE_TRACE_LIGHT") && univ.party.town_num < 200)
+		std::cout << " light=" << univ.party.light_level << " rad=" << light_radius()
+			<< " lit=" << int(bool(univ.town->lighting[l.x][l.y]))
+			<< " ltype=" << int(univ.town->lighting_type);
+	if(getenv("BOE_TRACE_WINDOW"))
+		std::cout << " corner=(" << univ.party.outdoor_corner.x << "," << univ.party.outdoor_corner.y
+			<< ") iwc=(" << univ.party.i_w_c.x << "," << univ.party.i_w_c.y << ")";
+	std::cout << std::endl;
+	// BOE_TRACE_MONST adds the town's whole creature list, which is what a
+	// divergence in `do_monsters`' random walk needs: the drift shows up as one
+	// townsperson a square off, several hundred actions before anything blocks.
+	// Printed for town_num >= 200 as well, which is the outdoor combat arena:
+	// its creatures live in univ.town.monst like any others, and a fight in it
+	// is exactly where a do_monster_turn divergence needs to be read.
+	if(getenv("BOE_TRACE_MONST")) {
+		std::cout << "      monst:";
+		for(size_t i = 0; i < univ.town.monst.size(); i++)
+			if(univ.town.monst[i].is_alive())
+				std::cout << " " << i << ":(" << univ.town.monst[i].cur_loc.x
+					<< "," << univ.town.monst[i].cur_loc.y << ")"
+					// The active flag decides whether do_monsters picks a target
+					// at all, so two runs can agree on every position and still
+					// diverge here. Invisible until printed.
+					<< "a" << int(univ.town.monst[i].active)
+					// Health, because "it split on one side and died on the
+					// other" is a health divergence wearing a rules divergence's
+					// clothes, and nothing else in this trace can see it.
+					<< "h" << univ.town.monst[i].health
+					<< (getenv("BOE_TRACE_TARG")
+						? "->(" + std::to_string(univ.town.monst[i].targ_loc.x) + ","
+							+ std::to_string(univ.town.monst[i].targ_loc.y) + ")" : "");
+		std::cout << std::endl;
+	}
+	// BOE_TRACE_PCS: each PC's main_status, health and combat position. Whether
+	// a PC is alive gates a surprising amount of monster behaviour —
+	// `do_monster_turn` will not walk toward a dead one, `closest_pc` skips
+	// them — so a party-state divergence reads as a creature that moved on one
+	// side and not the other, with nothing about movement actually wrong.
+	if(getenv("BOE_TRACE_PCS")) {
+		std::cout << "      pcs:";
+		for(short p = 0; p < 6; p++)
+			std::cout << " " << p << ":s" << int(univ.party[p].main_status)
+				<< "/h" << univ.party[p].cur_health
+				// Max health too: a PC sitting *at* its maximum and one three
+				// points below it heal differently, and every heal in
+				// `increase_age` is gated on that comparison rather than on the
+				// current value alone.
+				<< "/m" << univ.party[p].max_health
+				// Level, because half a dozen spell formulas divide by it and
+				// a level that drifted is invisible everywhere else.
+				<< "/L" << univ.party[p].level
+				// Spell points, because `pc_can_cast_spell` refuses on them and
+				// a refusal makes **no draws at all** — so "one side cast the
+				// spell and the other didn't" reads in the draw stream as
+				// whatever rule happened to run next. `sp=0` in `[cast]` is the
+				// answer; this column is where the two runs first disagreed
+				// about it.
+				<< "/p" << univ.party[p].cur_sp
+				<< "/(" << univ.party[p].combat_pos.x << "," << univ.party[p].combat_pos.y << ")";
+		std::cout << std::endl;
+	}
+	// BOE_TRACE_ITEMS prints every PC's pack. An item divergence — a stack
+	// that split differently, a pack that compacted differently — otherwise
+	// only shows up as a dialog one side raises and the other doesn't.
+	if(getenv("BOE_TRACE_ITEMS")) {
+		for(short p = 0; p < 6; p++) {
+			std::cout << "      items pc" << p << ":";
+			for(size_t k = 0; k < univ.party[p].items.size(); k++) {
+				cItem& it = univ.party[p].items[k];
+				if(it.variety == eItemType::NO_ITEM) continue;
+				std::cout << " " << k << ":" << int(it.variety) << "/" << it.charges
+					<< "/" << int(it.type_flag)
+					// `+` for equipped. Which armour a PC is *wearing* is the
+					// half of the pack that `damage_pc` actually reads, and a
+					// pack that matches item for item can still differ here.
+					<< (univ.party[p].equip[k] ? "+" : "");
