+// ---- the native harness's action trace -------------------------------------
+//
+// `BOE_TRACE=1` prints one line per replayed action in the same shape as
+// exile-js's own `CORPUS=1 TRACE=1` output, so the two runs diff line for line
+// and the first differing line names the rule that diverged. Off by default:
+// the recordings are thousands of actions long.
+#include <execinfo.h>
