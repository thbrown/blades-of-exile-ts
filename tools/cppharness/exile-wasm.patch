+#ifdef BOE_NATIVE_REPLAY
+		// **The whole table, read from the same string resource the desktop
+		// build's parser uses** (`node_properties_t::opcode()`, special.cpp:589,
+		// is `get_str("specials-opcodes", int(type))`, so entry *i* of the list
+		// names type *i*).
+		//
+		// The hand-written list below knows 22 of the 228 opcodes and silently
+		// answers NONE for the rest, which does not fail — it produces a
+		// scenario whose scripting is mostly blank nodes, and the game then
+		// shows string 0 of the town where a dialog belonged. Harmless in the
+		// browser build only because nobody has noticed; fatal for a harness
+		// whose whole job is to be the reference.
+		{
+			static std::map<std::string, eSpecType> byName;
+			if(byName.empty()) {
+				const StringList& names = *ResMgr::strings.get("specials-opcodes");
+				for(size_t i = 0; i < names.size(); i++)
+					if(!names[i].empty()) byName[names[i]] = eSpecType(i + 1);
+			}
+			if(getenv("BOE_TRACE")) std::cout << "    [opcodes] " << byName.size() << " names; looking up '" << type << "'" << std::endl;
+			auto found = byName.find(type);
+			if(found != byName.end()) return found->second;
+			return eSpecType::NONE;
+		}
+#endif
 		// Opcode mappings from rsrc/strings/specials-opcodes.txt
