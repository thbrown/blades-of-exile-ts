node_modules/
dist/
*.local
.DS_Store
# Exile 3 game data is user-supplied — never commit it. It has been freeware
# since 2013, but its licence allows redistributing only the complete,
# unmodified archive (README.md, "Licence")
e3data/

# The native C++ harness build (tools/cppharness/README.md)
tools/cppharness/build/
# Cached traces from both engines (scripts/diverge.mjs) — regenerable, and a
# corpus run of them is hundreds of megabytes
tools/cppharness/traces/

# Community scenario archive downloads and conversion output (Part 1b) —
# third-party works, fetched by scripts, never committed
library/

# Scenario dumps from dump-scen.sh, cached by test/legacyImport.test.ts
tools/cppharness/scendumps/

# Ghidra project for EXILE3.EXE (tools/e3convert/ghidra/README.md) — derived
# from the commercial binary, regenerable in 20 seconds
tools/e3convert/ghidra/project/

# Exile 3 converted by tools/e3convert/convert.ts — a modified copy of
# Spiderweb's game, which its licence does not let us redistribute
public/scenarios/exile3/
