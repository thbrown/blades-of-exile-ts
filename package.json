{
  "name": "blades-of-exile-ts",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "description": "TypeScript rewrite of the Blades of Exile game player",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "predev": "vite-node tools/e3convert/ensure.ts",
    "e3": "vite-node tools/e3convert/ensure.ts --force"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@xmldom/xmldom": "^0.9.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.61.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
